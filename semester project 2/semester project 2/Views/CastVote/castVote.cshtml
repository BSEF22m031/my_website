@model List<semester_project_2.Models.Election>

<div class="container py-5">
    <h2 class="text-center text-primary mb-4">Current Elections Running</h2>

    <div class="row">
        @foreach (var election in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="election-box shadow-lg rounded text-center p-4 bg-light">
                    <h4 class="text-primary mb-3">@election.ElectionName</h4>
                    <p>Vote for your preferred candidates in the @election.ElectionName.</p>
                    <a href="@Url.Action("voteCasting", "VoteCasting", new { id = election.ElectionID })" class="btn btn-primary mt-3">Cast Your Vote</a>
                </div>
            </div>
        }
    </div>
</div>
