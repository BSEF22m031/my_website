            </div>
            <div class="col">
                <div class="candidate-card">
                    <img src="~/images/shehbaz_sharif_meets_putin_(2024-07-03)_(2)_(cropped).jpg" alt="Candidate 3" class="candidate-img">
                    <div class="candidate-info">
                        <h5>Mr. Shahbaz Sharif</h5>
