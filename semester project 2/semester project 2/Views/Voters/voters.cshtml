<div class="voter-info-page container py-5">
    <h1 class="text-center text-primary mb-4">Voter Information</h1>
    <p class="text-center text-muted">
        Voting is the cornerstone of democracy. It empowers citizens to have a voice in shaping their nation's future.
    </p>

    <div id="voterCarousel" class="carousel slide mb-4" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="/images/voters-count.jpg" class="d-block w-100" alt="Voter 1">
            </div>
            <div class="carousel-item">
                <img src="/images/mle-female-count-province-wise.jpg" class="d-block w-100" alt="Voter 2">
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#voterCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#voterCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>

    <p class="text-center text-success fs-5 fst-italic">
        "Every vote counts. Make your voice heard in shaping the future of Pakistan."
    </p>

    <div class="voter-registration mb-5 py-4 px-3 rounded shadow-sm">
        <h3 class="text-center text-primary mb-3">Voter Registration</h3>
        <div class="row">
            <div class="col-md-4 text-center">
                <div class="info-box p-3">
                    <i class="bi bi-person-check-fill text-success fs-2 mb-2"></i>
                    <h5>Age Requirement</h5>
                    <p>Minimum age: 18 years</p>
                </div>
            </div>
            <div class="col-md-4 text-center">
                <div class="info-box p-3">
                    <i class="bi bi-flag-fill text-warning fs-2 mb-2"></i>
                    <h5>Citizenship Requirement</h5>
                    <p>Must be a Pakistani citizen</p>
                </div>
            </div>
            <div class="col-md-4 text-center">
                <div class="info-box p-3">
                    <i class="bi bi-house-fill text-info fs-2 mb-2"></i>
                    <h5>Residency Requirement</h5>
                    <p>Must reside in the constituency</p>
                </div>
            </div>
        </div>
    </div>

    <div class="voting-process py-5 px-4 bg-light rounded shadow-sm">
        <h3 class="text-center text-primary mb-4">Voting Process</h3>
        <div class="d-flex align-items-center justify-content-center">
            <div class="process-step text-center mx-3">
                <i class="bi bi-person-fill text-success fs-2 mb-2"></i>
                <h6>Step 1</h6>
                <p>Login (if registered) or sign up.</p>
            </div>
            <span class="arrow-icon mx-3 fs-3 text-muted">&#8594;</span>
            <div class="process-step text-center mx-3">
                <i class="bi bi-search text-warning fs-2 mb-2"></i>
                <h6>Step 2</h6>
                <p>Verify your registration online.</p>
            </div>
            <span class="arrow-icon mx-3 fs-3 text-muted">&#8594;</span>
            <div class="process-step text-center mx-3">
                <i class="bi bi-geo-alt-fill text-info fs-2 mb-2"></i>
                <h6>Step 3</h6>
                <p>Move to Elections page</p>
            </div>
            <span class="arrow-icon mx-3 fs-3 text-muted">&#8594;</span>
            <div class="process-step text-center mx-3">
                <i class="bi bi-check-circle-fill text-danger fs-2 mb-2"></i>
                <h6>Step 4</h6>
                <p>Cast your vote securely.</p>
            </div>
        </div>
    </div>

</div>
