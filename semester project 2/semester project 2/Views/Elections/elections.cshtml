        <div class="row text-center">
            <div class="col-md-12">
                <h5 class="text-primary">Multiple Elections Across Provinces</h5>
                <p class="fs-5">Check the schedule for upcoming provincial and national elections.</p>
                <a href="https://localhost:7267/UpcomingElections/upcomingElection" class="btn btn-primary">View Upcoming Elections</a>
            </div>
        </div>
    </div>

