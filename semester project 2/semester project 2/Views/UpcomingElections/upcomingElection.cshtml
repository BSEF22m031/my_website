@model List<semester_project_2.Models.Election>

<div class="upcoming-elections-page bg-info-subtle p-4 rounded shadow-sm">
    <h3 class="text-center text-dark mb-4">Upcoming Elections</h3>
    <div class="text-center mb-4 bg-white p-3 rounded">
        <p class="fs-5">Participate in shaping the future of democracy. Check out the upcoming elections and make your voice heard!</p>
        <i class="bi bi-ballot text-primary fs-1"></i>
        <i class="bi bi-person-check text-success fs-1 mx-3"></i>
        <i class="bi bi-calendar-event text-danger fs-1"></i>
    </div>

    <div class="row">
        @foreach (var election in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow">
                    <div class="card-body">
                        <h5 class="card-title">@election.ElectionName</h5>
                        <p class="card-text">Scheduled Date: @election.Date.ToString("MMMM dd, yyyy - hh:mm tt")</p>
                        <button class="btn btn-primary mb-2" data-bs-toggle="collapse" data-bs-target="#details_@election.ElectionID" aria-expanded="false">Show Details</button>
                        <a href="https://localhost:7267/UpcomingRegister/upcomingRegister?electionName=@election.ElectionName" class="btn btn-success">Register</a>
                        <div id="details_@election.ElectionID" class="collapse mt-3">
                            <p>@election.Description</p>
                        </div>
                    </div>
                </div>
            </div>
        }

</div>
