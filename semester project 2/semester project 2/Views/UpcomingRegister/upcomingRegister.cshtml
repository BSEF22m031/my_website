<div class="container py-5">
    <h2 class="text-center text-primary mb-4">Register for Upcoming Elections</h2>

    <div class="register-section bg-light p-5 rounded shadow-sm mb-5">
        <h3 class="text-center text-dark mb-4">Enter Your CNIC Number</h3>
        <div class="row justify-content-center">
            <div class="col-md-6">
                <form action="/UpcomingRegister/upcomingRegister" method="POST">
                    <div class="form-group">
                        <label for="cnic" class="form-label">CNIC Number</label>
                        <input type="text" id="cnic" name="cnic" class="form-control form-control-lg" placeholder="Enter your 13-digit CNIC" required>
                        <small class="form-text text-muted">Please enter your CNIC without dashes.</small>
                    </div>
                    <input type="hidden" name="electionName" value="@ViewBag.ElectionName" />
                    <button type="submit" class="btn btn-primary btn-lg mt-3 w-100">Register</button>
                </form>
            </div>
        </div>
    </div>


    @if (ViewBag.Message == "Submitted")
    {
        <div class="status-section bg-light p-5 rounded shadow-sm">
            <h3 class="text-center text-dark mb-4">Registration Status</h3>

            @if (ViewBag.x == "yes")
            {
                <div class="text-center">
                    <div class="fs-4 text-success">
                        You are already registered for this upcoming election!
                    </div>
                </div>
            }
            else
            {
                <div class="text-center mt-5">
                    <div class="fs-4 text-danger">
                        You are now registered for the upcoming elections .
                    </div>
                    @* <p class="text-center mt-3">
                        <strong>Registration Status:</strong> <span class="text-warning">Not Registered</span>
                    </p>
                    <p>
                        <a href="https://localhost:7267/UpcomingRegister/upcomingRegister" class="btn btn-primary btn-lg">Register Now</a>
                    </p> *@
                </div>
            }
        </div>
    }
</div>
