<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - semester_project_2</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/semester_project_2.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    
    <nav class="navbar navbar-expand-lg navbar-dark ">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="#">
                <img src="~/images/emblem_of_the_election_commission_of_pakistan.svg" alt="Country Icon" class="country-icon">
                Election System
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="https://localhost:7267/Home/index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="https://localhost:7267/About/aboutUs">About Us</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="https://localhost:7267/Elections/elections">Elections</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="https://localhost:7267/Voters/voters">Voter Information</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="https://localhost:7267/Candidate/Candidates">Candidates</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="https://localhost:7267/Result/result">Results</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="https://localhost:7267/Contact/contact">Contact Us</a>
                    </li>
                    @if (Context.Request.Cookies["Username"] == "admin")
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Admin Panel
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                @* <li><a class="dropdown-item" href="https://localhost:7267/Dashboard/dashboard">Dashboard</a></li> *@
                                @* <li><a class="dropdown-item" href="https://localhost:7267/ManageElection/manageElection">Manage Elections</a></li> *@
                                <li><a class="dropdown-item" href="https://localhost:7267/UserManagement/userManagement">User Management</a></li>
                                <li><a class="dropdown-item" href="https://localhost:7267/Report/report">Reports</a></li>
                            </ul>
                        </li>
                    }
                    <div class="text-center">
                        @if (Context.Request.Cookies["Username"] != null)
                        {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                
                                <span style="font-size: 1rem; color: white;">Hello, @Context.Request.Cookies["Username"]!</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li><a class="dropdown-item" href="/LoginPage/Login">Logout</a></li>
                            </ul>
                        </li>
                        }
            </div>
            </ul>
            </div>
        </div>
    </nav>
    <header class="header-section">
        <div class="header-content text-center">
            <h1 class="display-4 fw-bold text-white">Empowering Democracy Through Technology</h1>
            <p class="lead text-light">Secure, Transparent, and Fair Elections at Your Fingertips</p>
            <a href="https://localhost:7267/General/learnMore" class="btn btn-primary btn-lg">Learn More</a>
        </div>
    </header>
</head>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<body>
    <div >
            @RenderBody()
    </div>

    <footer class="footer bg-dark text-light py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5 class="text-uppercase fw-bold mb-3">Our Location</h5>
                    <p>
                        Election Commission of Pakistan <br>
                        Constitution Avenue, Islamabad, Pakistan
                    </p>
                    <p>
                        <i class="bi bi-geo-alt"></i> <a href="https://g.co/kgs/HYLKHca" target="_blank" class="text-light text-decoration-none">View on Map</a>
                    </p>
                </div>
                <div class="col-md-4">
                    <h5 class="text-uppercase fw-bold mb-3">Contact Us</h5>
                    <p><i class="bi bi-telephone"></i> +92-51-1234567</p>
                    <p><i class="bi bi-envelope"></i> info@elections.gov.pk</p>
                    <p><i class="bi bi-clock"></i> Monday - Friday: 9 AM - 5 PM</p>
                </div>
                <div class="col-md-4">
                    <h5 class="text-uppercase fw-bold mb-3">Quick Links</h5>
                    <ul class="list-unstyled">
                        <li><a href="#about" class="text-light text-decoration-none">About Us</a></li>
                        <li><a href="#voter-info" class="text-light text-decoration-none">Voter Information</a></li>
                        <li><a href="#candidates" class="text-light text-decoration-none">Candidates</a></li>
                        <li><a href="#contact" class="text-light text-decoration-none">Contact Us</a></li>
                    </ul>
                </div>
            </div>
            <hr class="border-light my-4">
            <div class="row">
                <div class="col-md-6">
                    <p class="mb-0">Follow us:</p>
                    <a href="https://facebook.com" target="_blank" class="text-light me-2"><i class="bi bi-facebook"></i></a>
                    <a href="https://twitter.com" target="_blank" class="text-light me-2"><i class="bi bi-twitter"></i></a>
                    <a href="https://instagram.com" target="_blank" class="text-light me-2"><i class="bi bi-instagram"></i></a>
                    <a href="https://linkedin.com" target="_blank" class="text-light"><i class="bi bi-linkedin"></i></a>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-0">&copy; 2024 Election Commission of Pakistan. All Rights Reserved.</p>
                </div>
            </div>
        </div>
    </footer>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
