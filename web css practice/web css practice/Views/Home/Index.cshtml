<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flexbox Alignment Test</title>
    <link rel="stylesheet" href="styles.css">
    <style>
        .container {
            display: flex;
            flex-wrap: wrap;
            width: 80%;
            height: 300px;
            margin: auto;
            border: 2px solid black;
            background-color: #f3f3f3;
        }

        /* Testing justify-content */
        .justify-center {
            justify-content: center;
        }
        .justify-space-between {
            justify-content: space-between;
        }
        .justify-space-around {
            justify-content: space-around;
        }

        /* Testing align-items */
        .align-start {
            align-items: flex-start;
        }
        .align-center {
            align-items: center;
        }
        .align-end {
            align-items: flex-end;
        }

        /* Testing align-content (requires flex-wrap) */
        .align-content-space-between {
            align-content: space-between;
        }
        .align-content-center {
            align-content: center;
        }
        .align-content-flex-end {
            align-content: flex-end;
        }

        /* Testing align-self */
        .item {
            width: 100px;
            height: 50px;
            background-color: lightblue;
            margin: 5px;
            text-align: center;
            line-height: 50px;
            font-weight: bold;
        }
        .align-self-start {
            align-self: flex-start;
        }
        .align-self-center {
            align-self: center;
        }
        .align-self-end {
            align-self: flex-end;
        }

        .circle
        {
            border :2px solid black;
            border-radius:50%;
            margin:100px;
        }
    </style>
</head>
<body>
    <h1>Flexbox Alignment Testing</h1>

    <h2>Justify Content</h2>
    <div class="container justify-center">
        <div class="item">1</div>
        <div class="item">2</div>
        <div class="item">3</div>
    </div>
    <div class="container justify-space-between">
        <div class="item">1</div>
        <div class="item">2</div>
        <div class="item">3</div>
    </div>
    <div class="container justify-space-around">
        <div class="item">1</div>
        <div class="item">2</div>
        <div class="item">3</div>
    </div>

    <h2>Align Items</h2>
    <div class="container align-start">
        <div class="item">A</div>
        <div class="item">B</div>
        <div class="item">C</div>
    </div>
    <div class="container align-center">
        <div class="item">A</div>
        <div class="item">B</div>
        <div class="item">C</div>
    </div>
    <div class="container align-end">
        <div class="item">A</div>
        <div class="item">B</div>
        <div class="item">C</div>
    </div>

    <h2>Align Content</h2>
    <div class="container align-content-space-between" style="height: 400px; flex-wrap: wrap;">
        <div class="item">X</div>
        <div class="item">Y</div>
        <div class="item">Z</div>
    </div>
    <div class="container align-content-center" style="height: 400px; flex-wrap: wrap;">
        <div class="item">X</div>
        <div class="item">Y</div>
        <div class="item">Z</div>
    </div>
    <div class="container align-content-flex-end" style="height: 400px; flex-wrap: wrap;">
        <div class="item">X</div>
        <div class="item">Y</div>
        <div class="item">Z</div>
    </div>

    <h2>Align Self</h2>
    <div class="container">
        <div class="item align-self-start">Self Start</div>
        <div class="item align-self-center">Self Center</div>
        <div class="item align-self-end">Self End</div>
    </div>
    <h2>Align Self</h2>
    <div class="container">
        
        <div class="item circle" style="height: 100px; width:100px">abc</div>

    </div>
</body>
</html>
