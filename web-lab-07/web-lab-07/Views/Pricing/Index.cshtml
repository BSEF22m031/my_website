@{
    ViewBag.Title = "Pricing Plans";
}
<div class="bg-light text-dark  p-4">
<div class="pricing-header">
    <h1 class ="text-center">Get Started, Get Hired</h1>
    <p class ="text-center">Select a plan and get closer to your dream job today.</p>
</div>
    <div class="row ">
        <div class="col-md-4  ">
            <div class="card">
                <div class="card-header text-start text-primary fw-bold">
                    Basic
                
            </div>
            <div class="card-body text-center">
                <p>Perfect for those passively applying to jobs</p>
                <p class="text-start text-primary fw-bold">£7.99 <span class=" text-primary fw-bold ">/month</span></p>
                <ul class="list-unstyled">
                    <hr>

                    <li><i class="fas fa-check-circle text-primary"></i> Generate up to 5 cover letters per month</li>
                    <hr>

                    <li><i class="fas fa-check-circle text-primary"></i> Access to basic AI-generated content</li>
                    <hr>

                    <li><i class="fas fa-check-circle text-primary"></i> Download cover letters in Word / PDF format</li>
                </ul>
            </div>
            <div class="card-footer text-center">
                <a href="#" class="btn-get-started">Get started!</a>
            </div>
        </div>
    </div>
    <style>
        .text-purple {
            color: #6f42c1;
        }
    </style>

    <div class="col-md-4">
        <div class="card">
                <div class="card-header text-start text-purple fw-bold">
                Advanced (Most Popular)
            </div>
            <div class="card-body text-center">
                <p>Perfect for those actively applying to jobs and want to standout</p>
                <p class="text-start text-purple fw-bold">£19.99 <span class="text-purple fw-bold">/month</span></p>
                
                <ul class="list-unstyled">
                    <hr>
                    <li><i class="fas fa-check-circle text-purple"></i> Generate up to 20 cover letters per month</li>
                    <hr>
                    <li><i class="fas fa-check-circle text-purple"></i> Access to advanced AI-generated content for more personalised letters</li>
                    <hr>
                    <li><i class="fas fa-check-circle text-purple"></i> Download cover letters in Word / PDF format</li>
                </ul>
            </div>
            <div class="card-footer text-center">
                <a href="#" class="btn-get-started btn-get-started-advanced">Get started!</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
                <div class="card-header text-start text-success fw-bold">
                Super-Charged
            </div>
            <div class="card-body text-center">
                <p>Perfect for those who want to apply to many jobs and would like additional support</p>
                <p class="text-start text-success fw-bold">£99.99 <span class="text-success fw-bold">/month</span></p>
                <ul class="list-unstyled">
                    <hr>
                    <li><i class="fas fa-check text-success"></i> Generate up to 100 cover letters per month</li>
                    <hr>
                    <li><i class="fas fa-check-circle text-success"></i> Access to advanced AI-generated content for more personalised letters</li>
                    <hr>
                    <li><i class="fas fa-check-circle text-success"></i> Download cover letters in Word / PDF format</li>
                    <hr>
                    <li><i class="fas fa-check-circle text-success"></i> Priority support with weekly coaching sessions with a cover letter specialist</li>
                </ul>

               
            </div>
            <div class="card-footer text-center">
                <a href="#" class="btn-get-started btn-get-started-super">Get started!</a>
            </div>
        </div>
    </div>

    
</div>
</div>
