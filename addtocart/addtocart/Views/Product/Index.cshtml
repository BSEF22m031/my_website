@model IEnumerable<YourNamespace.Models.Product>

@{
    ViewBag.Title = "Products";
}

<h2>Products</h2>
<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Price</td>
                <td>
                    @Html.ActionLink("Add to Cart", "AddToCart", "Product", new { productId = product.Id }, null)
                </td>
            </tr>
        }
    </tbody>
</table>

<p>@Html.ActionLink("View Cart", "Cart", "Product")</p>
